OPENROUTER_CHAT_MODEL=cohere/north-mini-code:free
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

GEMINI_API_KEY=
