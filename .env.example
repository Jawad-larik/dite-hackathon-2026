# Database (MongoDB Atlas)
MONGODB_URI=

# Authentication (JWT HS256)
JWT_SECRET=your_jwt_secret_key_here

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MOCK_FALLBACK=false


